# Rostrum — local configuration
# Copy to .env and source it, or export these directly. Nothing here is read from a file
# by the server; it reads the process environment only.

# --- server ---------------------------------------------------------------
PORT=4173
BIND=127.0.0.1
# Absolute origin of the deployment. Required for OAuth and for Secure cookies.
# PUBLIC_ORIGIN=https://rostrum.example

# --- operator account -----------------------------------------------------
# Leave ADMIN_PASS unset to have one generated at first boot and printed to the console.
ADMIN_USER=operator
# ADMIN_PASS=

# --- profiles: where the data comes from ---------------------------------
# api       PROVIDER=api + FACEIT_API_KEY   open.faceit.com Data API
# browser   default without a key       drives a signed-in Chrome (see below)
# PROVIDER=browser
#
# The browser collector talks to a Chrome that already has a faceit.com session.
# Start that Chrome once with the debug port, sign in, leave it running:
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/.faceit-chrome"
CHROME_CDP=http://127.0.0.1:9222
# How long a collected profile is reused before the next resolve refetches it.
COLLECT_TTL_MINUTES=360

# --- FACEIT Data API ------------------------------------------------------
# https://developers.faceit.com/  →  create an app  →  Server-side API key
# FACEIT_API_KEY=

# --- FACEIT OAuth (ownership proof for alias claims) -----------------------
# Same app page; add <PUBLIC_ORIGIN>/claim/callback as a redirect URI.
# FACEIT_CLIENT_ID=
# FACEIT_CLIENT_SECRET=

# --- external destinations -------------------------------------------------
# Comma-separated hosts a link may point at. Empty = external destinations refused.
# Exact host or any subdomain of it. https only.
# EXTERNAL_ALLOWLIST=cup.example,faceit.com

# --- local testing only ---------------------------------------------------
# DEV_CLAIMS=1 lets you create claims without an ownership proof.
# Every page built from such a claim is stamped UNVERIFIED and cannot be restyled.
# DEV_CLAIMS=1

# DB_PATH=./data/rostrum.db
